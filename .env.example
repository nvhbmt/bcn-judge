# Biến môi trường của SPA (thư mục gốc). Server có file riêng: server/.env.example.
# Sao thành .env — .gitignore đã bỏ qua .env và .env.*, chỉ giữ lại .env.example.
#
# CHỈ biến bắt đầu bằng VITE_ mới lọt vào bundle và đọc được qua import.meta.env.
# Chúng bị NHÚNG THẲNG vào file JS lúc build, ai mở devtools cũng thấy — đừng bao
# giờ để secret ở đây.

# ── Địa chỉ API ────────────────────────────────────────────────────────────
# Ở dev để RỖNG: SPA gọi đường dẫn tương đối (/api, /auth) và vite proxy sang
# localhost:8099 (xem `server.proxy` trong vite.config.ts).
#
# Bản build production cũng phải RỖNG: SPA và API dùng chung origin sau Caddy.
# Dockerfile đã ghim `ENV VITE_API_BASE_URL=""`, nhưng nếu build tay mà quên thì
# Vite nhúng giá trị đang có trong .env vào bundle và trang thật sẽ gọi
# localhost — hỏng toàn bộ, không có lỗi nào chỉ về đây. Xem docs/deploy.md.
#
# Chỉ đặt giá trị khi FE chạy ở origin KHÁC API (ví dụ mở SPA ở máy này, API ở
# máy khác): VITE_API_BASE_URL=https://judge.example.vn
VITE_API_BASE_URL=

# ── Không đọc được từ file này ─────────────────────────────────────────────
# Mấy biến dưới đây do Node/script đọc qua process.env, mà Vite KHÔNG nạp .env
# vào process.env — phải truyền ngay trên dòng lệnh, để ở .env là vô tác dụng.
#
# Tên miền tunnel khi gửi bản dev cho người thử (vite chặn Host lạ):
#   BCN_DEV_HOST=thu.clb.vn npm run dev
#
# Cổng và database của bộ E2E (mặc định 5199 / 8399 / bcn_judge_e2e_ui):
#   E2E_VITE_PORT=5199 E2E_API_PORT=8399 E2E_DB=bcn_judge_e2e_ui npm run e2e
