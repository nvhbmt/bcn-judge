# Caddy đứng trước API (design.md §9).
{$BCN_DOMAIN:localhost} {
	encode gzip

	# SSE phải KHÔNG được buffer, nếu không verdict tới theo cụm và FR-F4 vỡ.
	@sse path /api/member/submissions/*/events /api/member/contests/*/events
	reverse_proxy @sse {$BCN_API_UPSTREAM:api-blue:8099} {
		flush_interval -1
	}

	reverse_proxy /api/* /auth/* /healthz {$BCN_API_UPSTREAM:api-blue:8099}

	# SPA build tĩnh; mọi route không phải file đều rơi về index.html.
	root * /srv/spa
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# `img-src` có thêm cdn.discordapp.com cho ảnh đại diện lấy từ Discord.
		#
		# KHÔNG bỏ được nếu muốn tính năng chạy: dev không có CSP nào nên ảnh hiện
		# bình thường, còn ở đây trình duyệt chặn CÂM — không lỗi mạng, không dòng log
		# nào ngoài console của người dùng. Đúng kiểu hỏng chỉ lộ ra sau khi deploy.
		#
		# Chỉ nới đúng host cần và đúng directive cần; script-src/connect-src giữ
		# nguyên 'self'. Đánh đổi thật: CDN của Discord thấy IP người đang xem trang.
		#
		# `style-src` có fonts.googleapis.com và `font-src` có fonts.gstatic.com vì
		# index.html nạp cả ba họ chữ (Lora, IBM Plex, Montserrat của logo) từ Google
		# Fonts. Thiếu hai host này thì trình duyệt chặn CÂM y như ca ảnh Discord ở
		# trên: dev không có CSP nên chữ đẹp bình thường, deploy xong cả ba mặt chữ
		# lặng lẽ rơi về font hệ thống — nhận diện của hệ thiết kế biến mất mà không
		# một dòng log nào. Muốn bỏ hai host này thì self-host font trước
		# (tải .woff2 về, xem design-system/tokens/fonts.css), đừng bỏ suông.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self'; frame-ancestors 'none'"
	}
}
