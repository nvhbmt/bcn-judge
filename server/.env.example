# Secrets tách theo service (ADR-5 vòng 2): worker KHÔNG được cầm SESSION_SECRET
# hay DATABASE_URL của app — worker bị chiếm thì không đi vòng qua ba role Postgres.
# Sao thành .env.api / .env.worker / .env.migrate.

# ── .env.api ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bcn_app:CHANGE_ME@postgres:5432/bcn_judge
PORT=8099
NODE_ENV=production
SECURE_COOKIE=1
SESSION_TTL_DAYS=30

# Đăng nhập bằng Discord — TUỲ CHỌN. Thiếu bất kỳ dòng nào trong ba dòng này là
# tính năng TẮT hẳn và nút Discord không hiện ở màn đăng nhập (tắt-thì-giấu, không
# tắt-thì-lỗi). Lấy ở https://discord.com/developers/applications → OAuth2.
#
# DISCORD_REDIRECT_URI phải TRÙNG TỪNG KÝ TỰ với Redirect URI khai trong portal.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://judge.example.vn/auth/discord/callback
#
# Khai DISCORD_GUILD_ID là ĐỔI CHÍNH SÁCH TRUY CẬP: ai ở trong server Discord đó
# đăng nhập sẽ được TẠO tài khoản member ngay, không cần mentor cấp. Bỏ trống = tắt.
# DISCORD_ROLE_ID siết thêm: phải mang đúng role đó mới vào được.
# DISCORD_GUILD_ID=
# DISCORD_ROLE_ID=

# ── .env.worker ────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://bcn_worker:CHANGE_ME@postgres:5432/bcn_judge
# DOCKER_HOST=tcp://docker-proxy:2375
# WORKER_SLOTS=2
# WORKER_CPUSET=2,3

# ── .env.migrate ───────────────────────────────────────────────────────────
# DATABASE_URL=postgres://bcn_migrate:CHANGE_ME@postgres:5432/bcn_judge

# ── docker-compose ─────────────────────────────────────────────────────────
POSTGRES_USER=bcn
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bcn_judge
BCN_DOMAIN=judge.example.vn
